# ───────────────────────────────────────────────────────────────────
# משתני סביבה של הלקוח.
# כל מה שמתחיל ב-VITE_ נארז לתוך קוד ה-JavaScript ונחשף לכל גולש.
# לכן נכנסים לכאן רק מפתחות ציבוריים.
# ───────────────────────────────────────────────────────────────────

# כתובת פרויקט ה-Supabase.
# Supabase ← Project Settings ← API ← Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# מפתח anon. ציבורי במכוון — RLS היא מה שמגן על הנתונים.
# Supabase ← Project Settings ← API ← Project API keys ← anon public
# ⚠ לעולם לא להכניס כאן את מפתח ה-service_role.
VITE_SUPABASE_ANON_KEY=

# כתובת שרת ה-API.
# בפיתוח: http://localhost:8080
# בייצור: https://<השירות-שלך>.onrender.com
VITE_API_URL=http://localhost:8080

# מצב הזדהות: supabase (ברירת מחדל) או local.
# local — כניסה ללא סיסמה כמשתמש דמו, ועובד רק יחד עם AUTH_MODE=local בשרת.
# פעיל רק ב-npm run dev; בבנייה לייצור המשתנה מתעלם, גם אם הוגדר בטעות.
VITE_AUTH_MODE=supabase
