# ───────────────────────────────────────────────────────────────────
# משתני סביבה של השרת.
# העתק ל-.env ומלא ערכים אמיתיים. הקובץ .env לעולם אינו עולה ל-Git.
# ───────────────────────────────────────────────────────────────────

# ── מסד הנתונים ──────────────────────────────────────────────────
# מחרוזת החיבור ל-Postgres של Supabase.
# Supabase ← Project Settings ← Database ← Connection string ← URI
# בחר/י את מצב "Transaction pooler" (פורט 6543) — הוא המתאים ל-Render.
# החלף/י [YOUR-PASSWORD] בסיסמת מסד הנתונים שקבעת ביצירת הפרויקט.
# ⚠ שווה ערך למפתח service_role: עוקף RLS. שרת בלבד.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── מצב הזדהות ────────────────────────────────────────────────────
# supabase — הרגיל, ומה שחייב לרוץ בייצור.
# local    — כניסה ללא סיסמה כאחד ממשתמשי הדמו, בלי פרויקט Supabase.
#            לפיתוח ולהדגמה בלבד: השרת מסרב לעלות במצב הזה כש-NODE_ENV=production,
#            ומאזין רק ל-127.0.0.1. במצב הזה SUPABASE_URL ו-SUPABASE_ANON_KEY אינם נדרשים.
# ⚠ לעולם לא להגדיר local ב-Render.
AUTH_MODE=supabase

# ── Supabase Auth ─────────────────────────────────────────────────
# כתובת הפרויקט. Supabase ← Project Settings ← API ← Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# מפתח anon. משמש את השרת כדי לאמת טוקנים של משתמשים מול Supabase Auth.
# Supabase ← Project Settings ← API ← Project API keys ← anon public
SUPABASE_ANON_KEY=

# מפתח service_role. משמש לפעולות ניהול משתמשים (הזמנות, השבתה).
# ⚠ לעולם אינו נכנס לקוד הלקוח, ל-Git או ל-Cloudflare Pages.
SUPABASE_SERVICE_ROLE_KEY=

# ── אפליקציה ──────────────────────────────────────────────────────
# כתובת הלקוח. CORS מוגבל אך ורק אליה.
# בפיתוח: http://localhost:5173
# בייצור: https://<הפרויקט-שלך>.pages.dev
# ניתן לציין כמה כתובות מופרדות בפסיק.
CLIENT_URL=http://localhost:5173

# הפורט שעליו השרת מאזין. ב-Render המשתנה מוזרק אוטומטית — אל תגדיר/י אותו שם.
PORT=8080

# סוד משותף לנתיבי /internal/cron. צור/י מחרוזת אקראית ארוכה, למשל:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# development | production
NODE_ENV=development

# debug | info | warn | error
LOG_LEVEL=info
